{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@tidecove/core": ["../../packages/core/src/index.ts"],
      "@tidecove/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/app/**/*",
    "src/components/**/*",
    "src/lib/**/*",
    "src/pages/**/*",
    "src/styles/**/*"
  ],
  "exclude": ["src/features/**", "src/services/**", "node_modules", "dist"]
}
